/* [wxMaxima batch file version 1] [ DO NOT EDIT BY HAND! ]*/
/* [ Created with wxMaxima version 22.04.0 ] */
/* [wxMaxima: input   start ] */
kill(all);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/*Tranfer Function*/;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
F(s):=5/(s+5);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/*DC GAIN K*/;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
K:limit(F(s),s,0);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/*Step Signal*/;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
R(s):=1/s;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/*Step Response*/;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
Y(s):=R(s)*F(s);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
Y(s);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/*Expanding into Partial Fractions*/;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
Y:partfrac(Y(s),s);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/*Inverse Laplace Transform*/;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
y(t):=ilt(Y,s,t);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
y(t);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/*System Time Constant 1/5*/;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
tau:float(solve(y(t)=0.632,t));
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/*Rise Time 10% to 90%*/;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
t1:float(solve(y(t)=0.1,t));
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
t2:float(solve(y(t)=0.9,t));
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
tr:t2-t1;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/*Setting Time*/;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
ts:4*tau;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
ts:solve(1-%e^(-5*t)-1=0.02,t);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
set:float(realpart(rhs(ts[5])));
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
/*Step Response of the System*/;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
wxdraw2d(
grid=true,
xaxis=true,
yaxis=true,
dimensions=[600,600],
xrange=[-0.1,4],
yrange=[-0.1,1.2],
point_type=7,
points([[rhs(last(t1)),0.1],[rhs(last(t2)),0.9],[set,0.98]]),
label(["t1",rhs(last(t1)),0.2],["t2",rhs(last(t2)),1],["ts",set,1.1]),
title="Step Response",
color=red,
explicit(y(t),t,-0.1,3.9)
);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
rhs(last(t1));
/* [wxMaxima: input   end   ] */



