/* [wxMaxima: input   start ] */
/*Electronica de potencia*/;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
kill(all);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
Amplitude: 120*sqrt(2);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
freq: 50;
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
Vin(t):=Amplitude*sin(2*%pi*freq*t);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
wxplot2d(Vin(t),[t,0,0.04],[y,-220,220],[legend,"Sine"],[xlabel,"time"],[ylabel,"Volt"],grid2d);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
integrate(Vin(t), t, 0, 0.02);
/* [wxMaxima: input   end   ] */


/* [wxMaxima: input   start ] */
integrate(sqrt(Vin(t)^2), t, 0, 0.02),numer;
/* [wxMaxima: input   end   ] */



