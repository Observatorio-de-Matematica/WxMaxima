wxdraw2d(
grid=true,
xaxis=true,
yaxis=true,
dimensions=[600,600],
xrange=[-4,4],
yrange=[-4,4],
title="The unit circle and the line x=3.",
color=black,
parametric(3,t,t,-4,4),
color=red,
implicit(x^2+y^2=1,x,-1,1,y,-1,1)
);
